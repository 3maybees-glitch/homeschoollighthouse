# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias for newer Supabase secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_PREMIUM_LIFETIME_PRICE_ID=
STRIPE_NAVIGATOR_PRICE_ID=

# Development helpers
DEV_PREMIUM_TIER=false
# Force-unlock The Navigator without Stripe (local testing)
DEV_NAVIGATOR_ACCESS=false
# Comma-separated owner emails that always receive premium when logged in (for testing)
OWNER_PREMIUM_EMAILS=3maybees@gmail.com

# Admin moderation queue
ADMIN_SECRET=

# Email (newsletter welcome + future Beacon Bulletin sends)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Homeschool Lighthouse <beacon@yourdomain.com>
# Bright Beacon advertising inquiries (defaults to first OWNER_PREMIUM_EMAILS entry)
ADVERTISE_INQUIRY_EMAIL=

# AI (optional — uses smart local matching without this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firecrawl (web scraping for research + bulk listing imports)
FIRECRAWL_API_KEY=
